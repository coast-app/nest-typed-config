{
  "name": "@coast/nest-typed-config",
  "publishConfig": {
    "access": "public"
  },
  "version": "4.0.0",
  "description": "Intuitive, type-safe configuration module for Nest framework",
  "author": "Coast Engineering",
  "license": "MIT",
  "packageManager": "pnpm@7.33.1",
  "files": [
    "index.js",
    "index.d.ts",
    "index.ts",
    "lib",
    "dist"
  ],
  "scripts": {
    "prepare": "husky install",
    "build": "rimraf -rf dist && tsc -p tsconfig.build.json",
    "test": "cross-env NODE_OPTIONS=--experimental-vm-modules jest --runInBand",
    "test:watch": "cross-env NODE_OPTIONS=--experimental-vm-modules jest --runInBand --watch",
    "test:cov": "cross-env NODE_OPTIONS=--experimental-vm-modules jest --runInBand --coverage",
    "doc": "typedoc lib/index.ts --tsconfig tsconfig.build.json",
    "lint": "eslint {lib/**/*.ts,tests/**/*.ts,examples/**/*.ts} --fix",
    "lint:dontfix": "eslint {lib/**/*.ts,tests/**/*.ts,examples/**/*.ts}",
    "format": "prettier --write .",
    "format:dontfix": "prettier --check .",
    "prepublish:npm": "npm run build",
    "prerelease": "npm run build",
    "release": "semantic-release"
  },
  "dependencies": {
    "chalk": "4.1.2",
    "debug": "4.3.4",
    "lodash.frompairs": "4.0.1",
    "lodash.merge": "4.6.2",
    "set-value": "^4.1.0"
  },
  "devDependencies": {
    "@commitlint/cli": "17.7.1",
    "@iarna/toml": "2.2.5",
    "@latipun7/commitlintrc": "1.1.3",
    "@latipun7/releaserc": "^2.1.0",
    "@nestjs/axios": "12.0.1",
    "@nestjs/common": "12.3.2",
    "@nestjs/core": "12.3.2",
    "@nestjs/platform-express": "12.3.2",
    "@nestjs/testing": "12.3.2",
    "@types/debug": "4.1.8",
    "@types/express": "4.17.17",
    "@types/jest": "30.0.0",
    "@types/lodash.frompairs": "4.0.7",
    "@types/lodash.merge": "4.6.7",
    "@types/node": "18.17.17",
    "@types/set-value": "^4.0.1",
    "@typescript-eslint/eslint-plugin": "5.62.0",
    "@typescript-eslint/parser": "5.62.0",
    "axios": "1.21.0",
    "class-transformer": "0.5.1",
    "class-validator": "^0.14.0",
    "cosmiconfig": "8.3.6",
    "cross-env": "10.1.0",
    "dotenv": "16.3.1",
    "dotenv-expand": "10.0.0",
    "eslint": "7.32.0",
    "eslint-config-prettier": "9.0.0",
    "eslint-plugin-import": "2.28.1",
    "eslint-plugin-prettier": "4.2.1",
    "husky": "8.0.3",
    "jest": "30.5.2",
    "lint-staged": "14.0.1",
    "parse-json": "7.1.0",
    "prettier": "2.8.8",
    "reflect-metadata": "0.1.13",
    "rimraf": "5.0.1",
    "rxjs": "7.8.1",
    "semantic-release": "^22.0.0",
    "ts-jest": "29.4.15",
    "typedoc": "0.25.1",
    "typescript": "5.2.2",
    "yaml": "2.3.2"
  },
  "optionalDependencies": {
    "@iarna/toml": ">= 2.2.5",
    "@nestjs/axios": "^12.0.0",
    "axios": "^1.3.1",
    "cosmiconfig": ">= 8.0.0",
    "dotenv": ">= 16.0.0",
    "dotenv-expand": ">= 10.0.0",
    "parse-json": ">= 7.0.0",
    "yaml": ">= 1.10.2"
  },
  "peerDependencies": {
    "@nestjs/common": "^11.0.0 || ^12.0.0",
    "class-transformer": "*",
    "class-validator": "*",
    "reflect-metadata": ">= 0.1.12 < 0.3",
    "rxjs": "^7.1.0"
  },
  "commitlint": {
    "extends": [
      "@latipun7/commitlintrc"
    ]
  },
  "release": {
    "extends": [
      "@latipun7/releaserc"
    ]
  },
  "lint-staged": {
    "**/*.ts": [
      "eslint --fix",
      "prettier --write"
    ],
    "**/*": "prettier --write --ignore-unknown"
  }
}
